{
  "manifest_version": 3,
  "name": "My Tracker",
  "version": "1.0.0",
  "description": "Track daily goals with timers, counters, and checkboxes. Monitor your discipline through detailed reports and analytics.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    },
    "default_title": "My Tracker"
  },
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/assets/sounds/*.wav"],
      "matches": ["<all_urls>"]
    }
  ]
}
